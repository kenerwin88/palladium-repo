FROM ghcr.io/astral-sh/uv:0.12.9-python3.13-bookworm-slim
WORKDIR /workspace
RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY app/backend/pyproject.toml app/backend/uv.lock ./
RUN uv sync --frozen
COPY app/backend/ ./
EXPOSE 5000
CMD ["uv", "run", "flask", "--app", "palladium:create_app", "run", "--debug", "--host", "0.0.0.0"]

